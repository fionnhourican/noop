# ==============================================================================
# NOOP Home Lab Configuration
# Copy this file to .env and replace placeholders with secure random secrets.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=noop
POSTGRES_PASSWORD=generate_a_secure_database_password_here
POSTGRES_DB=noop_homelab

# Windows Ingestion Bearer Token
# Must match the token configured in the Windows agent Credential Manager
INGESTION_TOKEN=generate_a_random_token_here_at_least_32_characters

# Web Dashboard Session Token / Password
DASHBOARD_TOKEN=generate_a_separate_dashboard_token_here

# Application Port (binds to 127.0.0.1 on the Linux host)
PORT=8080
